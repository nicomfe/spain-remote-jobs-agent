SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin
# cron does not inherit the container environment. cron-env.mjs copies the
# output paths and the crawl secrets from pid 1 before the job runs.
# Daily crawl of kept Directory boards (UTC). Public JSON is the mounted volume.
0 4 * * * /usr/local/bin/node /app/scripts/cron-env.mjs /app/scripts/daily-crawl.sh
# Twice-monthly rediscovery of YC, Common Crawl, and Wellfound (UTC).
0 5 1,15 * * /usr/local/bin/node /app/scripts/cron-env.mjs /bin/sh /app/scripts/discover.sh
